<section class="aduro-concerns" id="aduro-concerns-{{ section.id }}">
  <div class="common-container">
    <div class="aduro-concerns__media">
      <div class="aduro-concerns__img-wrap">
        {%- if section.settings.desktop_image != blank -%}
          <picture>
            {%- if section.settings.mobile_image != blank -%}
              <source
                media="(max-width: 989px)"
                srcset="{{ section.settings.mobile_image | image_url: width: 780 }} 780w, {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w, {{ section.settings.mobile_image | image_url: width: 1600 }} 1600w"
                sizes="100vw"
              >
            {%- endif -%}
            {{
              section.settings.desktop_image
              | image_url: width: 1800
              | image_tag:
                class: 'aduro-concerns__img',
                widths: '800, 1200, 1600, 1800',
                sizes: '(max-width: 989px) 100vw, 50vw',
                loading: 'lazy'
            }}
          </picture>
        {%- endif -%}
      </div>
    </div>

    <div class="aduro-concerns__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="{%if section.settings.change-font-size == false %}aduro-concerns__heading{% else %} aduro-concerns__sec-heading{% endif %}">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="{%if section.settings.change-font-size == false %}aduro-concerns__text{% else %} aduro-concerns__sec-text{% endif %}">{{ section.settings.text | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="aduro-glass-btn">{{ section.settings.button_label }}</a>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="aduro-concerns__badges">
          {%- for block in section.blocks -%}
            <div class="aduro-concerns__badge" {{ block.shopify_attributes }}>

              {%- if block.settings.icon != blank -%}
              <span class="aduro-concerns__badge-icon">
                  {{
                    block.settings.icon
                    | image_url: width: 72
                    | image_tag: width: 18, height: 18, alt: '', loading: 'lazy'
                  }}
                {% comment %} {%- else -%}
                  {%- case forloop.index -%}
                    {%- when 1 -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h12v9H2z"/><path d="M14 9h4l3 3v3h-7"/><circle cx="6" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/><path d="M5.5 10.5l2 2 3.5-3.5"/></svg>
                    {%- when 2 -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2.2 2.2L15.5 10"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4v10l-8 4-8-4V7z"/><path d="M4 7l8 4 8-4M12 11v10"/></svg>
                  {%- endcase -%} {% endcomment %}
                </span>
              {%- endif -%}
              <span class="aduro-concerns__badge-text {% if block.settings.icon == blank %}  gray-color {% endif %}">{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
.aduro-concerns {
  --ac-gap: 48px;
  padding: 32px 0;

}

.aduro-concerns .common-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: var(--ac-gap);
  /* padding: 64px; */
}

.aduro-concerns .aduro-concerns__media {
  width: calc((100% - var(--ac-gap)) * 0.5095);
}

.aduro-concerns .aduro-concerns__img-wrap {
  width: 100%;
  aspect-ratio: 644 / 600;
  border-radius: 16px;
  overflow: hidden;
}

.aduro-concerns .aduro-concerns__img-wrap picture {
  display: block;
  width: 100%;
  height: 100%;
}

.aduro-concerns .aduro-concerns__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.aduro-concerns .aduro-concerns__content {
  width: calc((100% - var(--ac-gap)) * 0.4905);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.aduro-concerns .aduro-concerns__heading {
  margin: 0 0 16px 0;
  font-size: 32px;
  font-weight: 500;
  line-height: 41px;
  letter-spacing: -1px;
  color: #1c1917;
      max-width: 330px;
}
.aduro-concerns .aduro-concerns__sec-heading{
  margin: 0 0 24px;
  font-size: 28px;
  font-weight: 500;
  line-height: 100%;
  letter-spacing: 0;
  color: #1c1917;
}

.aduro-concerns .aduro-concerns__text {
  margin: 0 0 32px 0;
  font-size: 18px;
  font-weight: 400;
  line-height: 24px;
  color: #292524;
}
.aduro-concerns .aduro-concerns__sec-text {
  margin: 0 0 32px 0;
  font-size: 16px;
  font-weight: 400;
  line-height: 24px;
  color: #292524;
}

.aduro-concerns .aduro-concerns__badges {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  margin-top: 16px;
}

.aduro-concerns .aduro-concerns__badge {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding: 0 16px;
}

.aduro-concerns .aduro-concerns__badge:first-child {
  padding-left: 0;
}

.aduro-concerns .aduro-concerns__badge:last-child {
  padding-right: 0;
}

.aduro-concerns .aduro-concerns__badge + .aduro-concerns__badge::before {
  content: "";
  position: absolute;
  top: 2px;
  left: 0;
  width: 1px;
  height: 20px;
  background-color: #e7e5e4;
}

.aduro-concerns .aduro-concerns__badge-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  color: #44403c;
}

.aduro-concerns .aduro-concerns__badge-icon svg,
.aduro-concerns .aduro-concerns__badge-icon img {
  display: block;
  width: 18px;
  height: 18px;
}

.aduro-concerns .aduro-concerns__badge-text {
  font-size: 12px;
  font-weight: 400;
  line-height: 24px;
  white-space: nowrap;
  color: #1A1A1A;
}
.aduro-concerns .aduro-concerns__badge-text.gray-color{
  color:#78716C;
}

@media (max-width: 1199px) {
  .aduro-concerns {
    --ac-gap: 32px;
  }

  .aduro-concerns .aduro-concerns__sec-text {
    margin-bottom:24px;
  }
}
@media(max-width: 991px){
    .aduro-concerns {
    --ac-gap: 24px;
    {% comment %} padding: 32px 0; {% endcomment %}
  }
  .aduro-concerns .aduro-concerns__badge-icon{
    display: none;
  }
  .aduro-concerns .aduro-concerns__badge{
    padding: 0 10px;
  }
  

  .aduro-concerns .aduro-concerns__text,
  .aduro-concerns .aduro-concerns__sec-text {
    font-size: 16px;
    line-height: 24px;
    margin-bottom: 24px;
  }
  .aduro-concerns .aduro-concerns__text br:first-child,
  .aduro-concerns .aduro-concerns__sec-text br:first-child{
    display: none;
  }

}
@media (max-width: 767px) {
  .aduro-concerns {
    --ac-gap: 24px;
    padding: 24px 0;
  }

  .aduro-concerns .common-container {
    flex-direction: column;
    align-items: stretch;
    padding: 0 20px;
  }

  .aduro-concerns .aduro-concerns__media,
  .aduro-concerns .aduro-concerns__content {
    width: 100%;
  }

  .aduro-concerns .aduro-concerns__img-wrap {
    aspect-ratio: 350 / 326;
    border-radius: 20px;
  }

  .aduro-concerns .aduro-concerns__heading {
    font-size: 28px;
    line-height: 31px;
    letter-spacing: 0;
  }
  .aduro-concerns .aduro-concerns__sec-heading{
    margin: 0 0 16px;
    font-size: 28px;
    line-height: 31px;
  }
  .aduro-concerns .aduro-concerns__badge{
    padding: 0 16px;
  }

  .aduro-concerns .aduro-concerns__badges {
    margin-top: 8px;
  }
  {%if section.settings.change-font-size == true %}
    .aduro-concerns .aduro-concerns__badges {
      margin-top: 16px;
    }
  {% endif %}

  .aduro-concerns .aduro-concerns__badge-icon {
    display: none;
  }
}

@media (max-width: 389px) {
  .aduro-concerns .aduro-concerns__badge {
    padding: 0 8px;
  }

  .aduro-concerns .aduro-concerns__badge:first-child {
    padding-left: 0;
  }

  .aduro-concerns .aduro-concerns__badge:last-child {
    padding-right: 0;
  }
}

@media(max-width: 375px){
  .aduro-concerns .aduro-concerns__badges{
    flex-wrap: wrap;
  }
}
</style>

{% schema %}
{
  "name": "Aduro Concerns",
  "tag": "section",
  "class": "aduro-concerns-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "change-font-size",
      "label": "Change font size"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Multiple skin concerns, one device"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Fine lines today. Dullness tomorrow. Breakouts, redness or uneven tone. The new Aduro Facial Mask gives you the flexibility to choose a different light program as your skin's needs change."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the mask"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aduro Concerns",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "text": "Free 60-Day Returns"
          }
        },
        {
          "type": "badge",
          "settings": {
            "text": "1-year warranty"
          }
        },
        {
          "type": "badge",
          "settings": {
            "text": "Free shipping"
          }
        }
      ]
    }
  ]
}
{% endschema %}
