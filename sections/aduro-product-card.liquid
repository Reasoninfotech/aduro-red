{%- assign pcard_product = section.settings.product -%}
{%- assign pcard_variant = pcard_product.selected_or_first_available_variant -%}

{%- assign pcard_desktop_image = section.settings.desktop_image -%}
{%- if pcard_desktop_image == blank -%}
  {%- assign pcard_desktop_image = pcard_product.featured_image -%}
{%- endif -%}

<section class="aduro-pcard" id="aduro-pcard-{{ section.id }}">
  <div class="aduro-pcard__card">
    <div class="aduro-pcard__media">
      {%- if pcard_desktop_image != blank -%}
        <picture>
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 767px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 780 }} 780w, {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w, {{ section.settings.mobile_image | image_url: width: 1600 }} 1600w"
              sizes="100vw"
            >
          {%- endif -%}
          {{
            pcard_desktop_image
            | image_url: width: 1600
            | image_tag:
              class: 'aduro-pcard__img',
              widths: '800, 1200, 1600',
              sizes: '(max-width: 989px) 100vw, 50vw',
              loading: 'lazy'
          }}
        </picture>
      {%- endif -%}

      {%- if section.settings.badge_text != blank -%}
        <span class="aduro-pcard__badge">{{ section.settings.badge_text }}</span>
      {%- endif -%}
    </div>

    <div class="aduro-pcard__content">
      <div class="aduro-pcard__rating">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="aduro-pcard__rating-app" {{ block.shopify_attributes }}>
              {%- render block -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.trust_text != blank -%}
          <span class="aduro-pcard__rating-divider"></span>
          <span class="aduro-pcard__rating-trust">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
              <circle cx="9" cy="9" r="9" fill="#2f8bf7"/><path d="M5 9.2l2.7 2.7L13 6.6" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ section.settings.trust_text }}
          </span>
        {%- endif -%}
      </div>

      {%- if pcard_product != blank -%}
        <h2 class="aduro-pcard__title">{{ pcard_product.title }}</h2>

        <div class="aduro-pcard__price">
          <span class="aduro-pcard__price-now">{{ pcard_variant.price | money_without_trailing_zeros }}</span>
          {% comment %} {%- if pcard_variant.compare_at_price > pcard_variant.price -%} {% endcomment %}
          <span class="aduro-pcard__price-old">
            {{- pcard_variant.compare_at_price | money_without_trailing_zeros -}}
          </span>
          {% comment %} {%- endif -%} {% endcomment %}
        </div>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="aduro-pcard__text">{{ section.settings.text | escape | newline_to_br }}</p>
      {%- endif -%}

      <div class="aduro-pcard__finance">
        {%- if section.settings.financing_text != blank -%}
          <span class="aduro-pcard__finance-text">{{ section.settings.financing_text }}</span>
        {%- endif -%}
        <div class="aduro-pcard__finance-logos">
          {%- for block in section.blocks -%}
            {%- if block.type == 'financing' -%}
              <div class="aduro-pcard__finance-item" {{ block.shopify_attributes }}>
                {%- if block.settings.logo != blank -%}
                  {{
                    block.settings.logo
                    | image_url: width: 300
                    | image_tag: class: 'aduro-pcard__finance-logo', alt: block.settings.name, loading: 'lazy'
                  }}
                {%- else -%}
                  <span class="aduro-pcard__finance-name">{{ block.settings.name }}</span>
                {%- endif -%}
                <svg
                  class="aduro-pcard__finance-info"
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1"
                  aria-hidden="true"
                >
                  <circle cx="7" cy="7" r="6"/><path d="M7 6.2v3.8" stroke-linecap="round"/><circle cx="7" cy="4.2" r="0.5" fill="currentColor"/>
                </svg>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.button_label != blank and pcard_product != blank -%}
        <div class="aduro-pcard__action">
          {%- if section.settings.enable_add_to_cart -%}
            {%- if settings.cart_type != 'page' -%}
              <product-form-component
                data-section-id="{{ section.id }}"
                data-product-id="{{ pcard_product.id }}"
                on:submit="/handleSubmit"
              >
            {%- endif -%}
            {%- form 'product', pcard_product, class: 'aduro-pcard__form', data-cart-type: settings.cart_type -%}
              <input type="hidden" name="id" ref="variantId" value="{{ pcard_variant.id }}">
              {%- if pcard_variant.available -%}
                <button type="submit" name="add" class="aduro-glass-btn">{{ section.settings.button_label }}</button>
              {%- else -%}
                <button type="button" class="aduro-glass-btn" disabled>Sold out</button>
              {%- endif -%}
            {%- endform -%}
            {%- if settings.cart_type != 'page' -%}
              </product-form-component>
            {%- endif -%}
          {%- else -%}
            <a href="{{ pcard_product.url }}" class="aduro-glass-btn">{{ section.settings.button_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="aduro-pcard__trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <div class="aduro-pcard__trust-item" {{ block.shopify_attributes }}>
              <p class="aduro-pcard__trust-title">{{ block.settings.title }}</p>
              <p class="aduro-pcard__trust-text">{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.secure_title != blank -%}
          <div class="aduro-pcard__trust-item aduro-pcard__trust-item--secure">
            <p class="aduro-pcard__trust-title">{{ section.settings.secure_title }}</p>
            <div class="aduro-pcard__pay">
              {%- assign pcard_pay_types = 'visa,american_express,master,shopify_pay,apple_pay' | split: ',' -%}
              {%- for pay_type in pcard_pay_types -%}
                {{ pay_type | payment_type_svg_tag: class: 'aduro-pcard__pay-icon' }}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.enable_add_to_cart and pcard_product != blank -%}
  <script>
    (function () {
      var root = document.getElementById('aduro-pcard-{{ section.id }}');
      if (!root) return;

      var form = root.querySelector('.aduro-pcard__form');
      if (!form) return;

      var rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

      /* open the drawer instantly on click, contents refresh as soon as the add finishes */
      form.addEventListener('submit', function () {
        if (form.getAttribute('data-cart-type') === 'page') return;
        var drawer = document.querySelector('cart-drawer-component, cart-drawer');
        if (drawer && typeof drawer.open === 'function') drawer.open();
      });

      form.addEventListener('submit', function (event) {
        /* theme has its own product form component -> it handles ajax add + drawer */
        if (window.customElements && window.customElements.get('product-form-component')) return;

        var drawer = document.querySelector('cart-drawer-component, cart-drawer');

        /* cart type = page (or no drawer in theme) -> normal submit, goes to cart page */
        if (form.getAttribute('data-cart-type') === 'page' || !drawer) return;

        event.preventDefault();

        var button = form.querySelector('button[type="submit"]');
        if (button) button.disabled = true;

        var body = { items: [{ id: Number(form.elements.id.value), quantity: 1 }] };
        var hasRender = typeof drawer.renderContents === 'function' && typeof drawer.getSectionsToRender === 'function';

        if (hasRender) {
          body.sections = drawer.getSectionsToRender().map(function (section) {
            return section.id;
          });
          body.sections_url = window.location.pathname;
        }

        fetch(rootUrl + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(body)
        })
          .then(function (response) {
            if (!response.ok) throw new Error('add to cart failed');
            return response.json();
          })
          .then(function (state) {
            /* Dawn style drawer: render + open */
            if (hasRender) {
              drawer.renderContents(state);
              return;
            }

            /* Horizon style drawer: cart:update event refreshes and opens it */
            return fetch(rootUrl + 'cart.js')
              .then(function (response) {
                return response.json();
              })
              .then(function (cart) {
                document.dispatchEvent(
                  new CustomEvent('cart:update', {
                    bubbles: true,
                    detail: {
                      resource: cart,
                      sourceId: 'aduro-pcard-{{ section.id }}',
                      data: {
                        itemCount: cart.item_count,
                        source: 'product-form-component'
                      }
                    }
                  })
                );

                setTimeout(function () {
                  var dialog = drawer.querySelector('dialog');
                  if (typeof drawer.open === 'function' && dialog && !dialog.open) drawer.open();
                }, 400);
              });
          })
          .catch(function (error) {
            console.error(error);
          })
          .then(function () {
            if (button) button.disabled = false;
          });
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .aduro-pcard-section{
    padding: 67px 0;
  }
  .aduro-pcard-section .aduro-pcard {
    width: 100%;
    padding: 0 64px;
    box-sizing: border-box;
    font-family: 'DM Sans', sans-serif;
    max-width: 1218px;
      margin: 0 auto;
  }

  .aduro-pcard-section .aduro-pcard__card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    border-radius: 16px;
    overflow: hidden;
    background-color: #ffffff;
    box-shadow: 0 16px 60px 0 rgba(0, 0, 0, 0.08);
  }

  .aduro-pcard-section .aduro-pcard__media {
    position: relative;
    width: 48.91%;
  }

  .aduro-pcard-section .aduro-pcard__media picture {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .aduro-pcard-section .aduro-pcard__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aduro-pcard-section .aduro-pcard__badge {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border-radius: 100px;
    background-color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    line-height: 100%;
    white-space: nowrap;
    color: #000000;
  }

  .aduro-pcard-section .aduro-pcard__content {
    width: 51.09%;
    box-sizing: border-box;
    padding: 40px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .aduro-pcard-section .aduro-pcard__rating {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 22px;
  }

  .aduro-pcard-section .aduro-pcard__rating-divider {
    width: 1px;
    height: 22px;
    margin: 0 8px;
    background-color: #d6d3d1;
  }

  .aduro-pcard-section .aduro-pcard__rating-trust {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 400;
    line-height: 19px;
    color: #1A1A1A;
  }

  .aduro-pcard-section .aduro-pcard__rating-trust svg {
    display: block;
    width: 16px;
    height: 16px;
  }

  .aduro-pcard-section .aduro-pcard__title {
    margin: 16px 0 0;
    font-size: 44px;
    font-weight: 500;
    line-height: 50px;
    letter-spacing: -1px;
    color: #1c1917;
  }

  .aduro-pcard-section .aduro-pcard__price {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 9px;
    margin-top: 24px;
  }

  .aduro-pcard-section .aduro-pcard__price-now {
    font-size: 32px;
    font-weight: 700;
    line-height: 100%;
    color: #1c1917;
  }

  .aduro-pcard-section .aduro-pcard__price-old {
    font-size: 24px;
    font-weight: 500;
    line-height: 100%;
    text-decoration: line-through;
    color: #78716c;
  }

  .aduro-pcard-section .aduro-pcard__text {
    margin: 24px 0 0 0;
    font-size: 18px;
    font-weight: 400;
    line-height: 27px;
    color: #292524;
  }

  .aduro-pcard-section .aduro-pcard__finance {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: 6px;
    row-gap: 6px;
    margin-top: 24px;
    font-size: 12px;
    line-height: 19px;
    color: #828282;
  }

  .aduro-pcard-section .aduro-pcard__finance-logos {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }

  .aduro-pcard-section .aduro-pcard__finance-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 3.4px;
  }

  .aduro-pcard-section .aduro-pcard__finance-item + .aduro-pcard__finance-item::before {
    content: "-";
    margin: 0 10px 0 8px;
    color: #828282;
  }

  .aduro-pcard-section .aduro-pcard__finance-logo {
    display: block;
    width: auto;
    height: 13px;

  }

  .aduro-pcard-section .aduro-pcard__finance-name {
    font-size: 16px;
    font-weight: 700;
    color: #1c1917;
  }

  .aduro-pcard-section .aduro-pcard__finance-info {
    display: block;
    width: 14px;
    height: 14px;
    color: #78716c;
  }

  .aduro-pcard-section .aduro-pcard__action {
    display: flex;
    flex-direction: column;
    margin-top: 16px;
  }

  .aduro-pcard-section .aduro-pcard__form {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
  }

  .aduro-pcard-section .aduro-pcard__trust {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-top: 24px;
  }

  .aduro-pcard-section .aduro-pcard__trust-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0 28px;
    border-right: 1px solid #E7E5E4;
  }

  .aduro-pcard-section .aduro-pcard__trust-item:first-child {
    padding-left: 0;
  }

  .aduro-pcard-section .aduro-pcard__trust-item:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .aduro-pcard-section .aduro-pcard__trust-title {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 700;
    line-height: 100%;
    white-space: nowrap;
    color: #000000;
  }

  .aduro-pcard-section .aduro-pcard__trust-text {
    margin: 0;
    font-size: 12px;
    font-weight: 400;
    line-height: 100%;
    white-space: nowrap;
    color: #1A1A1A;
  }

  .aduro-pcard-section .aduro-pcard__pay {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 5px;
  }

  .aduro-pcard-section .aduro-pcard__pay-icon {
    display: block;
    width: 28px;
    height: 18px;
  }

  @media (max-width: 1199px) {
    .aduro-pcard-section .aduro-pcard {
      padding: 0 32px;
    }

    .aduro-pcard-section .aduro-pcard__content {
      padding: 32px 24px;
    }

    .aduro-pcard-section .aduro-pcard__title {
      font-size: 38px;
      line-height: 46px;
      letter-spacing: -1.2px;
    }

    .aduro-pcard-section .aduro-pcard__finance-logo {
      height: 16px;
    }

    .aduro-pcard-section .aduro-pcard__trust-item {
      padding: 0 14px;
    }

    .aduro-pcard-section .aduro-pcard__pay {
      gap: 4px;
    }

    .aduro-pcard-section .aduro-pcard__pay-icon {
      width: 22px;
      height: 14px;
    }
  }
  @media (max-width: 991px) {
      .aduro-pcard-section{
    padding: 47px 0;
  }
      .aduro-pcard-section .aduro-pcard__title {
        font-size: 32px;
        line-height: 40px;
        letter-spacing: 0px;
      }
      .aduro-pcard-section .aduro-pcard__trust{
        flex-wrap: wrap;
        row-gap: 10px;
        justify-content: center;
      }
      .aduro-pcard-section .aduro-pcard__price-now{
        font-size: 28px;
      }
      .aduro-pcard-section .aduro-pcard__price-old {
        font-size: 22px;
      }
  }
  @media (max-width: 767px) {

      .aduro-pcard-section{
      padding: 24px 0;
    }
    .aduro-pcard-section .aduro-pcard {
      padding: 0 20px;
    }

    .aduro-pcard-section .aduro-pcard__card {
      flex-direction: column;
      /* border-radius: 28px; */
      box-shadow: 0 8px 30px 0 rgba(0, 0, 0, 0.1);
    }

    .aduro-pcard-section .aduro-pcard__media {
      width: 100%;
      aspect-ratio: 350 / 384;
    }

    .aduro-pcard-section .aduro-pcard__badge {
      top: 16px;
      left: 16px;
    }

    .aduro-pcard-section .aduro-pcard__content {
      width: 100%;
      padding: 20px;
    }

    .aduro-pcard-section .aduro-pcard__rating {
      flex-direction: column;
      align-items: flex-start;
      row-gap: 7px;
      min-height: 0;
    }

    .aduro-pcard-section .aduro-pcard__rating-divider {
      display: none;
    }

    .aduro-pcard-section .aduro-pcard__rating-trust svg {
      width: 16px;
      height: 16px;
    }

    .aduro-pcard-section .aduro-pcard__title {
      margin-top: 20px;
      font-size: 28px;
      font-weight: 600;
      line-height: 34px;
      letter-spacing: 0;
    }

    .aduro-pcard-section .aduro-pcard__price {
      margin-top: 20px;
      gap: 8px;
    }

    .aduro-pcard-section .aduro-pcard__price-now {
      font-size: 32px;
    }

    .aduro-pcard-section .aduro-pcard__price-old {
      font-size: 28px;
    }
    .aduro-pcard-section .aduro-pcard__trust-title {
      font-size: 12px;
    }

    .aduro-pcard-section .aduro-pcard__text {
      margin-top: 20px;
      font-size: 16px;
      line-height: 25px;
    }
    .aduro-pcard-section .aduro-pcard__action{
      margin-top: 20px;
    }

    .aduro-pcard-section .aduro-pcard__finance {
      margin-top: 20px;
      row-gap: 8px;
      flex-wrap: wrap;
    }

    .aduro-pcard-section .aduro-pcard__finance-logo {
      height: 15px;
    }

    .aduro-pcard-section .aduro-pcard__finance-info {
      display: none;
    }

    .aduro-pcard-section .aduro-pcard__finance-item + .aduro-pcard__finance-item::before {
      margin: 0 14px 0 0;
    }

    .aduro-pcard-section .aduro-pcard__trust {
      flex-wrap: wrap;
      align-items: flex-start;
      column-gap: 16px;
      row-gap: 20px;
      margin-top: 20px;
    }

    .aduro-pcard-section .aduro-pcard__trust-item {
      box-sizing: border-box;
      padding: 0;
      border:0;
    }

    .aduro-pcard-section .aduro-pcard__trust-item--secure {
      width: 100%;
      align-items: center;
    }

    .aduro-pcard-section .aduro-pcard__pay {
      justify-content: center;
      gap: 6px;
      margin-top: 4px;
    }

    .aduro-pcard-section .aduro-pcard__pay-icon {
      width: 34px;
      height: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aduro Product Card",
  "tag": "section",
  "class": "aduro-pcard-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "enable_add_to_cart",
      "label": "Enable add to cart (off = go to product page)",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Save 15% today"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust text",
      "default": "Trusted by 100k+ verified customer"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The new Aduro Facial Mask combines 11 targeted light therapy treatments in one powerful device, bringing professional skincare into the comfort of your home."
    },
    {
      "type": "text",
      "id": "financing_text",
      "label": "Financing text",
      "default": "or from $82.95/month with"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the mask"
    },
    {
      "type": "text",
      "id": "secure_title",
      "label": "Secure checkout title",
      "default": "Secure checkout"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "30-day guarantee"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Shop with confidence"
        }
      ]
    },
    {
      "type": "financing",
      "name": "Financing logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
