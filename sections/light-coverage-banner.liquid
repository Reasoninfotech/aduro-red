<style>
  .lcb {
    width: 100%;
    padding: 32px 0;
  }
  .lcb__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    min-height: 555px;
    margin: 0 auto;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f3d9d4;
    color: #1a1a1a;
  }

  .lcb__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    margin: 0;
  }

  .lcb__media picture,
  .lcb__media img,
  .lcb__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .lcb__media svg {
    background: #f3d9d4;
    fill: rgba(0, 0, 0, 0.08);
  }

  .lcb__content {
    width: 100%;
    padding: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .lcb__heading {
    margin: 0;
    font-weight: 500;
    font-size: 52px;
    line-height: 58px;
    letter-spacing: -1px;
    text-align: center;
    vertical-align: middle;
    color: #1C1917;
    max-width: 430px;
  }

  .lcb__sub p{
    margin: 4px 0 0;
    font-weight: 400;
    max-width: 550px;
    font-size: 22px;
    line-height: 29px;
    letter-spacing: 0px;
    text-align: center;
    vertical-align: middle;
    color: #292524;
  }

  .lcb--v-top .lcb__card { align-items: flex-start; }
  .lcb--v-middle .lcb__card { align-items: center; }
  .lcb--v-bottom .lcb__card { align-items: flex-end; }

  .lcb--h-left .lcb__card { justify-content: flex-start; }
  .lcb--h-left .lcb__content { align-items: flex-start; text-align: left; }
  .lcb--h-center .lcb__card { justify-content: center; }
  .lcb--h-center .lcb__content { align-items: center; text-align: center; }
  .lcb--h-right .lcb__card { justify-content: flex-end; }
  .lcb--h-right .lcb__content { align-items: flex-end; text-align: right; }

  @media screen and (max-width: 767px) {
      .lcb {
    width: 100%;
    padding: 24px 0;
  }
  .lcb__heading {
      font-size: 42px;
    line-height: 47px;
  }
  .lcb__card {
      min-height: 450px;
    }
  .lcb__sub p {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 24px;
  }
    .lcb--hm-left .lcb__card { justify-content: flex-start; }
    .lcb--hm-left .lcb__content { align-items: flex-start; text-align: left; }
    .lcb--hm-center .lcb__card { justify-content: center; }
    .lcb--hm-center .lcb__content { align-items: center; text-align: center; }
    .lcb--hm-right .lcb__card { justify-content: flex-end; }
    .lcb--hm-right .lcb__content { align-items: flex-end; text-align: right; }
  }
   @media screen and (max-width: 575px) {
    .lcb__content {
        padding: 24px;
    }
    .lcb__heading {
        font-size: 32px;
        line-height: 35px;
        max-width: 300px;
    }
    .lcb__sub p {
        max-width: 300px;
    }
    .lcb__card {
        min-height: 420px;
    }
  }
</style>

<section class="lcb lcb--h-{{ section.settings.text_align }} lcb--hm-{{ section.settings.text_align_mobile }} lcb--v-{{ section.settings.vertical_align }}">
  <div class="common-container">
    <div class="lcb__card">
      <div class="lcb__media">
        {%- if section.settings.image != blank -%}
          <picture>
            {%- if section.settings.image_mobile != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ section.settings.image_mobile | image_url: width: 480 }} 480w,
                  {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
                  {{ section.settings.image_mobile | image_url: width: 1000 }} 1000w
                "
                sizes="100vw"
                width="{{ section.settings.image_mobile.width }}"
                height="{{ section.settings.image_mobile.height }}"
              >
            {%- endif -%}
            <img
              src="{{ section.settings.image | image_url: width: 1600 }}"
              srcset="
                {{ section.settings.image | image_url: width: 750 }} 750w,
                {{ section.settings.image | image_url: width: 1100 }} 1100w,
                {{ section.settings.image | image_url: width: 1600 }} 1600w,
                {{ section.settings.image | image_url: width: 2400 }} 2400w
              "
              sizes="100vw"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              loading="{% if section.index > 2 %}lazy{% else %}eager{% endif %}"
              decoding="async"
            >
          </picture>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'lcb__placeholder' }}
        {%- endif -%}
      </div>

      <div class="lcb__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="lcb__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subtext != blank -%}
          <div class="lcb__sub">{{ section.settings.subtext }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Light coverage banner",
  "tag": "div",
  "class": "section-light-coverage-banner",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Khali rakho to desktop image j mobile ma vaparse."
    },

    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "284 light sources, full-face coverage"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Advanced light therapy designed to feel effortless for at-home clinical treatments.</p>"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text alignment (mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "middle"
    }
  ],
  "presets": [
    {
      "name": "Light coverage banner"
    }
  ]
}
{% endschema %}
