{%- assign hero_product = section.settings.product -%}

<section class="aduro-hero" id="aduro-hero-{{ section.id }}">
  <div class="aduro-hero__media">
    {%- if section.settings.desktop_image != blank -%}
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 767px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 780 }} 780w, {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w, {{ section.settings.mobile_image | image_url: width: 1600 }} 1600w"
            sizes="100vw"
          >
        {%- endif -%}
        {{
          section.settings.desktop_image
          | image_url: width: 2880
          | image_tag:
            class: 'aduro-hero__img',
            widths: '1200, 1600, 2000, 2880',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      </picture>
    {%- endif -%}
  </div>

  <div class="aduro-hero__content">
    <div class="aduro-hero__main">
      {%- if section.settings.eyebrow != blank -%}
        <p class="aduro-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="aduro-hero__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="aduro-hero__text">{{ section.settings.text | escape | newline_to_br }}</p>
      {%- endif -%}

      <div class="aduro-hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="aduro-glass-btn">{{ section.settings.button_label }}</a>
        {%- endif -%}

        {%- if hero_product != blank -%}
          {%- assign hero_variant = hero_product.selected_or_first_available_variant -%}
          <div class="aduro-hero__price">
            <span class="aduro-hero__price-now">{{ hero_variant.price | money_without_trailing_zeros }}</span>
            {% comment %} {%- if hero_variant.compare_at_price > hero_variant.price -%} {% endcomment %}
              <span class="aduro-hero__price-old">{{ hero_variant.compare_at_price | money_without_trailing_zeros }}</span>
            {% comment %} {%- endif -%} {% endcomment %}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="aduro-hero__trust">
        <div class="aduro-hero__trust-inner">
          {%- for block in section.blocks -%}
            <div class="aduro-hero__trust-item" {{ block.shopify_attributes }}>
              <p class="aduro-hero__trust-title">{{ block.settings.title }}</p>
              <p class="aduro-hero__trust-text">{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.shopify-section.aduro-hero-section{
  margin-top: -67px;
  padding-bottom:32px;
}
.aduro-hero-section .aduro-hero {
  position: relative;
  width: 100%;
  aspect-ratio: 2576 / 1231;
  overflow: hidden;
  background-color: #d9dbe5;
}

.aduro-hero-section .aduro-hero__media {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.aduro-hero-section .aduro-hero__media::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(350.13deg, #FFFFFF 7.27%, rgba(255, 255, 255, 0) 27.71%);
  pointer-events: none;
}

.aduro-hero-section .aduro-hero__media picture {
  display: block;
  width: 100%;
  height: 100%;
}

.aduro-hero-section .aduro-hero__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: right center;
}

.aduro-hero-section .aduro-hero__content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.aduro-hero-section .aduro-hero__main {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 0 49px;
}

.aduro-hero-section .aduro-hero__eyebrow {
  margin: 0 0 16px;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.4;
  color: #57534e;
}

.aduro-hero-section .aduro-hero__heading {
  margin: 0 0 16px 0;
  font-size: 52px;
  font-weight: 500;
  line-height: 58px;
  letter-spacing: -1px;
  color: #1c1917;
}

.aduro-hero-section .aduro-hero__text {
      max-width: 520px;
    margin: 0 0 16px;
    font-size: 22px;
    font-weight: 400;
    line-height: 29px;
    color: #292524;
}

.aduro-hero-section .aduro-hero__actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16px;
}

.aduro-hero-section .aduro-hero__price {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8px;
}

.aduro-hero-section .aduro-hero__price-now {
  font-size: 32px;
  font-weight: 700;
  line-height: 1;
  color: #1c1917;
}

.aduro-hero-section .aduro-hero__price-old {
  font-size: 24px;
  font-weight: 400;
  line-height: 1;
  text-decoration: line-through;
  color: #78716c;
}

.aduro-hero-section .aduro-hero__trust {
  width: 100%;
  padding: 0 64px 24px 64px;
}

.aduro-hero-section .aduro-hero__trust-inner {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  padding-top: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.8);
      width: 100%;
    min-width: max-content;
}

.aduro-hero-section .aduro-hero__trust-title {
margin: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 100%;
    color: #1c1917;
}

.aduro-hero-section .aduro-hero__trust-text {
  margin: 4px 0 0 0;
  font-size: 16px;
  font-weight: 400;
  line-height: 26px;
  color: #292524;
}

@media (max-width: 1199px) {
  .aduro-hero-section .aduro-hero__main {
    padding: 40px 32px 0 32px;
  }

  .aduro-hero-section .aduro-hero__eyebrow {
    font-size: 16px;
    /* margin-bottom: 12px; */
  }

  .aduro-hero-section .aduro-hero__heading {
    font-size: 38px;
    line-height: 44px;
  }

  .aduro-hero-section .aduro-hero__text {
    max-width: 400px;
    font-size: 16px;
    line-height: 22px;
  }


  .aduro-hero-section .aduro-hero__trust {
    padding: 0 32px 16px 32px;
  }

  .aduro-hero-section .aduro-hero__trust-inner {
    padding-top: 16px;
  }

  .aduro-hero-section .aduro-hero__trust-text {
    margin-top: 2px;
  }
}
@media(max-width: 991px){
  .aduro-hero-section .aduro-hero{
    min-height: 460px;
  }
}

@media (max-width: 767px) {
  .shopify-section.aduro-hero-section{
  margin-top: 0px;
  padding-bottom:24px;
}
  .aduro-hero-section .aduro-hero {
    aspect-ratio: auto;
    overflow: visible;
    background-color: #ffffff;
  }

  .aduro-hero-section .aduro-hero__media {
    position: relative;
    height: auto;
    aspect-ratio: 1490 / 1480;
  }

  .aduro-hero-section .aduro-hero__media::after {
    display: none;
  }

  .aduro-hero-section .aduro-hero__img {
    object-position: center top;
  }

  .aduro-hero-section .aduro-hero__content {
    position: relative;
    height: auto;
    margin-top: -66px;
    z-index: 1;
  }

  .aduro-hero-section .aduro-hero__main {
    flex-grow: 0;
    justify-content: flex-start;
    padding: 0 20px 24px 20px;
  }

  .aduro-hero-section .aduro-hero__eyebrow {
    font-size: 12px;
    /* margin-bottom: 14px; */
  }

  .aduro-hero-section .aduro-hero__heading {
    font-size: 32px;
    line-height: 38px;
  }

  .aduro-hero-section .aduro-hero__text {
    max-width: 100%;
    /* margin-bottom: 24px; */
  }

  .aduro-hero-section .aduro-hero__actions {
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: 20px;
  }

  .aduro-hero-section .aduro-hero__price-old {
    font-size: 28px;
  }


  .aduro-hero-section .aduro-hero__trust {
    overflow-x: auto;
    padding: 0 24px 16px;
  }
  .aduro-hero-section .aduro-hero__trust-inner{
    gap:32px;
    border-top: 1px solid #D6D3D1;
  }
  .aduro-hero-section .aduro-hero__trust-text {
        font-size: 12px;
      line-height: 19px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Aduro Hero",
  "tag": "section",
  "class": "aduro-hero-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "7+1 wavelengths. 11 targeted programs. 1 simple routine."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Skin changes,\nLED therapy adapts"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Personalized light therapy for clearer, brighter, healthier-looking skin in just 10 minutes."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the mask"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product (for price)"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "On orders more than $75"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aduro Hero",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "title": "Free shipping",
            "text": "On orders more than $75"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "Easy return policy",
            "text": "60-day money-back guarantee"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "1 year warranty",
            "text": "Free replacement for product issues"
          }
        }
      ]
    }
  ]
}
{% endschema %}
