{%- doc -%}
  Renders a single stroke icon as inline SVG for the Custom footer section.
  All icons share one 48x48 grid, a 2px stroke and round caps/joins so they stay
  visually consistent. The icon inherits its colour from `currentColor`.

  @param {string} icon - One of: truck, box, shield, return, heart, star, gift, lock, chat, tag, clock

  @example
  {% render 'custom-footer-icon', icon: 'truck' %}
{%- enddoc -%}

<svg
  class="cf-icon"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'box' -%}
      <path d="M24 6l16 8v20l-16 8-16-8V14z" />
      <path d="M8 14l16 8 16-8M24 22v20M16 10l16 8" />
    {%- when 'shield' -%}
      <path d="M24 5l15 5.5V22c0 9.5-6.2 16.5-15 21C15.2 38.5 9 31.5 9 22V10.5z" />
      <path d="M17 24l5 5 9-10" />
    {%- when 'return' -%}
      <path d="M8 20a16 16 0 0 1 28-9l4 4M40 6v10H30M40 28a16 16 0 0 1-28 9l-4-4M8 42V32h10" />
    {%- when 'heart' -%}
      <path d="M24 41S6 30 6 17.5C6 11.7 10.5 8 15.5 8c3.6 0 6.8 2 8.5 5 1.7-3 4.9-5 8.5-5C37.5 8 42 11.7 42 17.5 42 30 24 41 24 41z" />
    {%- when 'star' -%}
      <path d="M24 6l5.4 11.4 12.1 1.5-8.9 8.4 2.3 12.3L24 33.6l-10.9 6 2.3-12.3-8.9-8.4 12.1-1.5z" />
    {%- when 'gift' -%}
      <rect x="7" y="18" width="34" height="9" rx="1.5" />
      <path d="M10 27v14h28V27M24 18v23M24 18c-2-6-10-8-10-3.5S21 18 24 18zM24 18c2-6 10-8 10-3.5S27 18 24 18z" />
    {%- when 'lock' -%}
      <rect x="10" y="21" width="28" height="20" rx="3" />
      <path d="M16 21v-6a8 8 0 0 1 16 0v6M24 29v5" />
    {%- when 'chat' -%}
      <path d="M8 10h32a2 2 0 0 1 2 2v20a2 2 0 0 1-2 2H22l-10 8v-8H8a2 2 0 0 1-2-2V12a2 2 0 0 1 2-2z" />
      <path d="M16 22h.01M24 22h.01M32 22h.01" />
    {%- when 'tag' -%}
      <path d="M42 26L26 42a2 2 0 0 1-2.8 0L6 24.8V8a2 2 0 0 1 2-2h16.8L42 23.2a2 2 0 0 1 0 2.8z" />
      <circle cx="15" cy="15" r="2.5" />
    {%- when 'clock' -%}
      <circle cx="24" cy="24" r="17" />
      <path d="M24 14v10l7 4" />
    {%- else -%}
      <rect x="10" y="11" width="22" height="22" rx="2" />
      <path d="M32 19h6l6 7v7H32M2 18h5M4 24h3M16 22l3.5 3.5L26 19" />
      <circle cx="17" cy="36" r="3" />
      <circle cx="38" cy="36" r="3" />
  {%- endcase -%}
</svg>
