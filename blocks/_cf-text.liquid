{%- comment -%}
  Footer text column for the Custom footer section. Styles live in sections/custom-footer.liquid (.cf-*).
{%- endcomment -%}
<div
  class="cf-col cf-col--text"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <h2 class="cf-col__heading">{{ block.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if block.settings.content != blank -%}
    <div class="cf-rte">{{ block.settings.content }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text",
      "default": "<p>Use this text area to tell your customers about your brand and vision. You can change it in the theme editor.</p>"
    }
  ]
}
{% endschema %}
